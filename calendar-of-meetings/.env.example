# Скопируйте этот файл в .env (он в .gitignore и в репозиторий не попадёт)
# и заполните реальными значениями:
#
#   cp .env.example .env
#
# npm run dev запускает node с --env-file=.env и читает переменные оттуда.
# Без них сервер отказывается стартовать (fail-fast, дефолтов нет).

# Пароль администратора — вход на страницу админки.
ADMIN_PASSWORD=

# Общий (гостевой) пароль — им делятся с приглашёнными на встречу.
GUEST_PASSWORD=

# Секрет подписи сессионных cookie (см. D3). Любая длинная случайная строка,
# например: openssl rand -hex 32
SESSION_SECRET=

# Необязательные — без них работают дефолты, указывать не обязательно.
# PORT=4000
# MEETINGS_DB_PATH=data/meetings.sqlite

# Дев-обход авторизации: AUTH_DISABLED=1 отключает проверку пароля — роль
# берётся из URL (/admin — владелец, остальное — гость), экран входа не нужен.
# Только для локальной проверки корректности; с ним наружу не выкладывать.
# AUTH_DISABLED=1
