# openapi-typescript@7 declares a stale peer typescript@"^5.x" while the project
# is on TypeScript 6; the generator works with TS 6 in practice (verified via
# npm run contract). This flag skips peer checks for the WHOLE tree on every
# install — if a real incompatibility appears, inspect peers by hand:
# npm view <pkg> peerDependencies.
legacy-peer-deps=true
